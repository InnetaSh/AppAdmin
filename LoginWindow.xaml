<Window x:Class="AppAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAdmin"
        mc:Ignorable="d"
               Title="Login" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="#FF322D6F">

        <Border BorderBrush="#FFEAEAEA" BorderThickness="3,3,3,3"   VerticalAlignment="Center" HorizontalAlignment="Center" Width="370" CornerRadius="10,10,10,10">

            <StackPanel Background="#FF322D6F">

                <Label  x:Name="Header" Content="Sing Up" Width="300" FontSize="38" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFD3D415" BorderThickness="0,15,0,0"/>

                <TextBlock Text="Enter Username:" FontSize="14" Margin="30,5,15,0" Foreground="White"/>
                <TextBox x:Name="UserName" Margin="5" Height="30" Width="300" ></TextBox>


                <TextBlock Text="Enter Password:" FontSize="14" Margin="30,5,15,0" Foreground="White"/>
                <PasswordBox x:Name="Password" Margin="5" Height="30" Width="300"></PasswordBox>


                <TextBlock  x:Name="ConfirmPasswordLabel"  
                       Text="Enter ConfirmPassword:" 
                       FontSize="14" 
                       Margin="30,5,15,0" 
                       Foreground="White"/>


                <PasswordBox x:Name="ConfirmPassword" 
                         Margin="5" 
                         Height="30" 
                         Width="300"/>


                <TextBlock  x:Name="EmailLabel"  
                       Text="Enter Email:" 
                       FontSize="14" 
                       Margin="30,5,15,0" 
                       Foreground="White"/>

                <TextBox x:Name="Email" 
                         Margin="5" Height="30" 
                         Width="300"  />


                <StackPanel x:Name="Gender" Orientation="Horizontal" Height="18" Width="300" HorizontalAlignment="Center" Margin="0,10,0,0" >
                    <CheckBox  Content="IsAdmin" x:Name="IsAdmin" IsChecked="False" Width="95" Foreground="White"  Padding="8,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnLogin" Margin="5,25,10,25" Height="40" Width="150" Content="Login" Foreground="White" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Click="LoginBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="#FF3D4DA5" BorderThickness="1" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>

                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF5064D2"/>
                                <GradientStop Color="#FF1B1B4C" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="White" Width="150" TextAlignment="Right">
                        <Hyperlink NavigateUri="#" RequestNavigate="Hyperlink_RequestNavigate_Register">
                            Register
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="Error" 
                     Margin="5" Height="30" 
                     Width="300"  
                    Foreground="Red" 
                    Text=""
                    Visibility="Collapsed"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>

