<Window x:Class="AppAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAdmin"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="Categories" SelectionChanged="Categories_SelectionChanged">
            <TabItem Header="TabItem" HorizontalAlignment="Left" Width="12">
                <TabItem.Template>
                    <ControlTemplate>
                        <Button x:Name="addCategory" Click="addCategory_Click">+</Button>
                    </ControlTemplate>
                </TabItem.Template>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
