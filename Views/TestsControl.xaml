<UserControl x:Class="AppAdmin.TestsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="TestsControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
        </Grid.Background>
        <Grid Margin="0,0,0,15" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="TestList" SelectionChanged="TestList_SelectionChanged" Grid.Row="0">

            </ListBox>
            <Button Content="Добавить тест" 
                Click="btnAddTest_Click" 
                Margin="15,15,15,0"
                HorizontalAlignment="Stretch"
                Grid.Row="1" />
            <Button  x:Name="btdelTest"
                 Content="Удалить тест" 
                 Click="btnDelTest_Click" 
                 Margin="15,5,15,0"
                 HorizontalAlignment="Stretch"
                 Grid.Row="2" />
            <Button  x:Name="bthangeNameTest"
                 Content="Изменить инфо про тест" 
                 Click="btnChangeNameTest_Click" 
                 Margin="15,5,15,0"
                 HorizontalAlignment="Stretch"
                 Grid.Row="3"  />
        </Grid>
        <Grid Margin="0,0,0,15" Grid.Column="1" ShowGridLines="False"> 
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock  x:Name="tbTime"  Margin="5,0,5,5" >Время:</TextBlock>
                <TextBlock  x:Name="tbDescription"  Margin="5,0,5,5"   TextWrapping="Wrap">Описание:</TextBlock>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Disabled" Grid.Row="1"  Margin="5,5,5,5">
                <StackPanel x:Name="pnTestList" />
            </ScrollViewer>
           
            <Button x:Name="btAddQuestion" 
                Grid.Row="2"
                Content="Добавить вопрос" 
                HorizontalAlignment="Right" 
                Margin="25,10,5,5" 
                VerticalAlignment="Top" 
                Width="110" 
                Click="btAddQuestion_Click" />
        </Grid>
    </Grid>
</UserControl>
