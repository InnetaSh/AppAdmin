<UserControl x:Class="AppAdmin.Views.UserTestListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAdmin.Views"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="600">
    <Border BorderBrush="Black" BorderThickness="2" Margin="20,10,20,10">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#80515151">
            <!--<Grid.Background>
            <ImageBrush x:Name="tbImgSrc" ImageSource="../img/back/back_default.png" 
                    Stretch="Fill" 
                    Viewport="0,0,1,1" 
                    ViewportUnits="RelativeToBoundingBox" />
        </Grid.Background>-->
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image x:Name="tbImgSrc" Source="../img/back/back_default_small.png" Grid.Row="0" Stretch="Fill" />
            <TextBlock x:Name="tbDescription" Foreground="#FFC3C3C3" FontSize="14" VerticalAlignment="Center" Margin="20" Grid.Row="1"  TextWrapping="Wrap" >Описание.....</TextBlock>

            <Button x:Name="btStart"  HorizontalAlignment="Right"  VerticalAlignment="Bottom"
                Margin="10,10,10,10"   Width="40" Height="40" Grid.Row="1" Click="btnStart_Click" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image Source="../img/icon_start.png" Stretch="Fill"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CountHeart}" Value="0">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Background" Value="{x:Null}"/>
                                <Setter Property="BorderBrush" Value="{x:Null}"/>
                                <Setter Property="Opacity" Value="0.05"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
        </Grid>
    </Border>
</UserControl>
