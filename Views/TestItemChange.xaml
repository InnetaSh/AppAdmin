<Window x:Class="AppAdmin.TestItemChange"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AppAdmin.Views"
             mc:Ignorable="d"
             Title="Change" Height="250" Width="600" WindowStartupLocation="CenterOwner">

    <Grid Margin="0,0,0,0">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
            </Grid.Background>
            <Grid  Grid.Column="0" ShowGridLines="False" Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tbTest"  HorizontalAlignment="Stretch" Margin="0,5,0,0" 
                         TextWrapping="Wrap" VerticalAlignment="Top" Width="450" Height="140" 
                         IsEnabled="True" Grid.Column="0"/>

                            
                    <Image x:Name="imageInTextBox" Width="140" Height="140" 
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                       Margin="0,5,0,0" Visibility="Collapsed" Grid.Column="1"/>
                </Grid>
                <Grid  Grid.Row="1" ShowGridLines="False" Margin="15,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="2*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ответы:"></TextBlock>
                    <StackPanel x:Name="pnAnswers" Margin="10,5,8,5" Orientation="Horizontal" Grid.Row="2">

                    </StackPanel>
                </Grid>

            </Grid>
            <Grid  Grid.Column="1" ShowGridLines="False" Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Button x:Name="saveBtn" Grid.Row="0" Content="Сохранить" HorizontalAlignment="Center" Margin="0,5,0,5" VerticalAlignment="Top" Width="110" Click="saveBtn_Click"/>
                <Button x:Name="imgBtn" Grid.Row="1" Content="Добавить рисунок" HorizontalAlignment="Center" Margin="0,5,0,5" VerticalAlignment="Top" Width="110" Click="addImgBtn_Click" FontSize="12"/>
                <Button x:Name="cancelTestBtn" Grid.Row="5" Content="Cancel" HorizontalAlignment="Center" Margin="0,5,0,5" VerticalAlignment="Top" Width="110" Click="cancelTestBtn_Click"/>

                <Button x:Name="addAnswerBtn" Grid.Row="2" Content="Добавить ответ" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,5" Width="110" Click="addAnswerBtn_Click" FontSize="12"/>
                <Button x:Name="delAnswerBtn" Grid.Row="3" Content="Удалить ответ" HorizontalAlignment="Center"  Margin="0,5,0,5" VerticalAlignment="Center" Width="110" Click="delAnswerBtn_Click" Visibility="Collapsed"  FontSize="12"/>
                <Button x:Name="changeAnswerBtn" Grid.Row="4" Content="Изменить ответ" HorizontalAlignment="Center"  Margin="0,5,0,5" VerticalAlignment="Center" Width="110" Click="changeAnswerBtn_Click" Visibility="Collapsed" FontSize="12"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
