<Window x:Class="AppAdmin.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAdmin.Views"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="UserWindow" Height="600" Width="800">
    <Grid Background="#FF3E3E3E">
        <TabControl x:Name="Categories" SelectionChanged="Categories_SelectionChanged" >
            <TabControl.Background>
                <ImageBrush ImageSource="../img/back.png" />
            </TabControl.Background>
            <TabItem HorizontalAlignment="Left" Width="40" Height="40">
                <TabItem.Template>
                    <ControlTemplate>
                        <Button x:Name="btnCabinet" Click="Cabinet_Click" Width="30" FontSize="16" FontWeight="Bold" Margin="5,5,5,5">
                            <Image Source="../img/icon_cabinet.png" Stretch="Fill"/>
                        </Button>
                    </ControlTemplate>
                </TabItem.Template>
                </TabItem>
            <TabItem HorizontalAlignment="Left" Width="60" Height="40"  Margin="1,0,0,0">
                <TabItem.Template>
                    <ControlTemplate>
                        <Border  BorderBrush="Black" BorderThickness="2">
                            <StackPanel  Margin="5" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image  x:Name="imgHeart" Source="../img/icon_heart.png" Stretch="Fill"  Margin="10,0,3,0"/>
                                <TextBlock x:Name="tbHeart"   Text="{Binding CountHeart}" FontSize="24" FontWeight="Bold"  Margin="0,-5,10,0" Foreground="White"></TextBlock>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </TabItem.Template>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="tbHeartCount"   Text="5" FontSize="24" FontWeight="Bold"  Margin="10,50,10,0" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" ></TextBlock>
        <!--<Button  HorizontalAlignment="Right" VerticalAlignment="Top"  Width="50" Height="50" Margin="10,50,10,0" BorderBrush="{x:Null}" Background="{x:Null}" >
            <Image Source="../img/icon_heart.png" Stretch="Fill"/>
        </Button>-->
    </Grid>
</Window>
