<Window x:Class="AppAdmin.Views.UserCabinetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAdmin.Views"
        mc:Ignorable="d"
         Loaded="Window_Loaded"
        Title="Cabinet" Height="450" Width="530">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.Background>
            <ImageBrush x:Name="tbImgSrc" ImageSource="../img/backCabinet.jpg" 
                 Stretch="Fill" 
                 Viewport="0,0,1,1" 
                 ViewportUnits="RelativeToBoundingBox" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid  Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="tbLogin" Foreground="#FFC3C3C3" FontSize="24" VerticalAlignment="Center"  HorizontalAlignment="Left"  Margin="40,0,0,0"   TextWrapping="Wrap"  Grid.Column="0" FontWeight="Bold" Width="110" Height="50">Login</TextBlock>

        </Grid>

        <ListBox x:Name="UserListBox"  Margin="10,10,10,0" Height="230" VerticalAlignment="Top" Grid.Row="1">
            <ListBox.Background>
                <SolidColorBrush Color="#50FFFFFF"/>

            </ListBox.Background>
        </ListBox>
        <Button x:Name="btOk" Content="Cancel" HorizontalAlignment="Right"  VerticalAlignment="Top"
       Margin="5,5,50,10"   Width="100" Height="20" Grid.Row="2" Click="btnOk_Click" Grid.RowSpan="2"/>
    </Grid>
</Window>
