<Window x:Class="AppAdmin.Views.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAdmin.Views"
        mc:Ignorable="d"
        Title="AddWindow" Height="130" Width="360" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="tbName" HorizontalAlignment="Left" Margin="90,16,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="265" Grid.ColumnSpan="2"/>
        <Label Content="Название" HorizontalAlignment="Left" Margin="10,12,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btAdd" Content="Добавить" HorizontalAlignment="Left" Margin="16,59,0,0" VerticalAlignment="Top" Click="btAdd_Click"/>
        <Button x:Name="btCancel" Content="Отменить" HorizontalAlignment="Left" Margin="90,59,0,0" VerticalAlignment="Top" Click="btCancel_Click"/>

    </Grid>
</Window>
