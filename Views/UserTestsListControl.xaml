<UserControl x:Class="AppAdmin.UserTestsListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="TestsControl_Loaded">
    <Grid  Margin="0,0,0,0"  ShowGridLines="False">
        <Grid.Background>
            <ImageBrush ImageSource="../img/backListWindow.png" 
                  x:Name="ImgSrc"   
                  Stretch="Fill" 
                  Viewport="0,0,1,1" 
                  ViewportUnits="RelativeToBoundingBox" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
       

        <TextBlock Text="Жизни закончились! Подождите восстановления."  x:Name="Error" 
                    Foreground="Red" FontSize="16" FontWeight="Bold" Grid.Row="0" Height="25" Width="363" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Visibility="Collapsed" Margin="0,0,0,70" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                        <DataTrigger  Binding="{Binding CountHeart, Mode=OneWay}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Disabled" Grid.Row="1"  Margin="5,5,5,5">
            <StackPanel x:Name="pnTestList"/>
        </ScrollViewer>


    </Grid>
</UserControl>
