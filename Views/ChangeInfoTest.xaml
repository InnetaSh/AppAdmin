<Window x:Class="AppAdmin.Views.ChangeInfoTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppAdmin.Views"
        mc:Ignorable="d"
        Title="Change" Height="300" Width="450" WindowStartupLocation="CenterOwner">
    <Grid  >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbChangeName" HorizontalAlignment="Left" Margin="15,5,0,5" 
              TextWrapping="Wrap" VerticalAlignment="Center" Width="320" Grid.Column="1" Height="25"/>
            <Label Content="Название" HorizontalAlignment="Left" Margin="15,0,0,0" 
                   VerticalAlignment="Center" Height="25" Width="70" RenderTransformOrigin="0.5,0.078" Grid.Column="0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Время (сек):" HorizontalAlignment="Left" Margin="15,0,0,0"
                 VerticalAlignment="Center" Height="25" FontSize="10" Width="98"  Grid.Column="0"/>
            <TextBox x:Name="tbTime" HorizontalAlignment="Left" Margin="15,5,0,5" PreviewTextInput="NumberValidationTextBox" 
                TextWrapping="Wrap" VerticalAlignment="Top" Width="320" Height="20" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Описание" HorizontalAlignment="Left" Margin="15,4,0,0" 
                    VerticalAlignment="Top" Height="25" Width="70" Grid.Column="0"/>
            <TextBox x:Name="tbChangeDescription" HorizontalAlignment="Left" Margin="15,0,0,0" 
                    TextWrapping="Wrap" VerticalAlignment="Center" Width="320"  Height="50" Grid.Column="1"/>

        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="29*"/>
            </Grid.ColumnDefinitions>

            <!--<Label Content="Back-img:" HorizontalAlignment="Left" Margin="15,5,0,5"
         VerticalAlignment="Center"  FontSize="10"  Grid.Column="0"/>-->
            <Button x:Name="imgBtn" Content="Добавить рисунок" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120" Click="addImgBtn_Click" FontSize="12" Height="20"/>
            <Image x:Name="imageInTextBox"  Height="70" Stretch="Uniform"  MaxWidth="10"
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="5,5,25,5"   Grid.Column="1"/>       
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btOk" Content="OK" HorizontalAlignment="Center"  VerticalAlignment="Center" Grid.Column="0"
          Margin="10,0,0,0"  Click="btOk_Click" Width="120" Height="20" Grid.Row="1"/>

            <Button x:Name="btCancel" Content="Отменить" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1"
          Margin="10,0,0,0"  Click="btCancel_Click" Width="120" Height="20" Grid.Row="1"/>
        </Grid>

    </Grid>
</Window>