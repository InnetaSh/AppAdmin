<UserControl x:Class="AppAdmin.TestItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="170" d:DesignWidth="800">
    <Grid Margin="0,0,0,0">
        <Grid Height="165" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
            </Grid.Background>
            <TextBox x:Name="tbTest" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="620" Height="110" IsEnabled="False"/>

            <Button x:Name="SaveOrNextBtn" Grid.Column="1" Content="Сохранить" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="75" Click="SaveOrNextBtn_Click"/>
            <Button x:Name="delTestBtn" Grid.Column="1" Content="Удалить" HorizontalAlignment="Center" Margin="0,45,0,0" VerticalAlignment="Top" Width="76" Click="delTestBtn_Click"/>
            <StackPanel x:Name="pnAnswers" Margin="10,125,8,5" Orientation="Horizontal">
                <RadioButton Content="RadioButton"/>
                <RadioButton Content="RadioButton" Margin="10,0,0,0" IsChecked="False"/>
            </StackPanel>
            <Button x:Name="addAnswerBtn" Grid.Column="1" Content="Добавить ответ" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Click="addAnswerBtn_Click"/>
            <Button x:Name="delAnswerBtn" Grid.Column="1" Content="Удалить ответ
                    " HorizontalAlignment="Center" Margin="0,133,0,0" VerticalAlignment="Top" Width="100" Click="delAnswerBtn_Click"/>
            <Button x:Name="changeAnswerBtn" Grid.Column="1" Content="Изменить ответ&#xD;&#xA;" HorizontalAlignment="Center" Margin="0,97,0,0" VerticalAlignment="Top" Width="100" Click="delAnswerBtn_Click" Height="23"/>
        </Grid>

    </Grid>
</UserControl>
