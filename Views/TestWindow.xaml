<Window x:Class="AppAdmin.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тестирование" Height="800" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="../img/back/back_default.png" 
             x:Name="ImgSrc"   
             Stretch="Fill" 
             Viewport="0,0,1,1" 
             ViewportUnits="RelativeToBoundingBox" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="350"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="QuestionPanel" VerticalAlignment="Center" Grid.Row="1">
            <TextBlock x:Name="QuestionText" Text="Вопрос будет здесь" FontSize="16" Margin="50,7,50,10"  Foreground="#FFC3C3C3" Grid.Row="1" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="AnswersPanel" VerticalAlignment="Center" Grid.Row="2">
            <Border x:Name="brdAnswer1" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="2" Padding="5" Margin="50,7,50,7">
                <Border.Background>
                    <SolidColorBrush Color="#80FFFFFF"/>
                </Border.Background>
                <RadioButton x:Name="Answer1" Content="Ответ 1" />
            </Border>
            <Border  x:Name="brdAnswer2" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="2" Padding="5" Margin="50,7,50,7">
                <Border.Background>
                    <SolidColorBrush Color="#80FFFFFF"/>
                </Border.Background>
                <RadioButton x:Name="Answer2" Content="Ответ 2" />
            </Border>
        </StackPanel>
        <StackPanel x:Name="pnProgressBar" VerticalAlignment="Center" Grid.Row="3">
            <TextBlock x:Name="Error" 
                  Margin="5,5,0,0" Height="30" 
                  Width="692"  
                 Foreground="Red" 
                 Text=""/>
            <Border BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="2" Padding="5" Margin="50,0,50,7" >
                <Border.Background>
                    <SolidColorBrush Color="#80FFFFFF"/>
                </Border.Background>
                <Grid HorizontalAlignment="Stretch">
                    <ProgressBar x:Name="TimerProgressBar" Height="20" Value="0" Maximum="100" Width="700"
             VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#446e9a"/>
                                <Setter Property="Background" Value="#7fa9c6"/>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock x:Name="TimerText" Text="01" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                 Foreground="#044080" FontSize="16"  FontWeight="Bold"/>
                </Grid>
            </Border>
        </StackPanel>




        <Grid x:Name="pnBtn" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*" />
                <ColumnDefinition/>
                <ColumnDefinition Width="26*" />
            </Grid.ColumnDefinitions>

            <Button Content="Завершить" x:Name ="BackQuestionButton" Click="FinishTestButton_Click" Margin="50,10,35,10" Grid.Column="0"/>
            <Button x:Name ="NextQuestionButton" Content="Далее" Click="NextQuestionButton_Click" Margin="50,10,50,10" Grid.Column="2"/>
        </Grid>


    </Grid>
</Window>
