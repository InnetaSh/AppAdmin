<Window x:Class="AppAdmin.Views.UserQuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тестирование" Height="800" Width="800">


    <Window.Resources>
        <Style x:Key="GradientButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="50,10,35,10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#FF3D4DA5" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF4a89cc"/>
                        <GradientStop Color="#FF182b3f" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="../img/back/back_default.png" 
             x:Name="ImgSrc"   
             Stretch="Fill" 
             Viewport="0,0,1,1" 
             ViewportUnits="RelativeToBoundingBox" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border  BorderBrush="Black" BorderThickness="2" CornerRadius="40" VerticalAlignment="Top" HorizontalAlignment="Right" Width="60" Height="60" Grid.Row="0" Margin="0,8,40,0" Background="#50FDE3E3">
            <StackPanel  Margin="5" HorizontalAlignment="Center" Orientation="Horizontal">
                <Image  x:Name="imgHeart" Source="../img/icon_heart.png" Stretch="Fill" Width="30" Height="30"  Margin="10,0,3,0"/>
                <TextBlock x:Name="tbHeart" FontSize="26" FontWeight="Bold"  Margin="0,5,10,0" Foreground="White">5</TextBlock>
            </StackPanel>
        </Border>
        <StackPanel x:Name="QuestionPanel" VerticalAlignment="Center" Grid.Row="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="QuestionText"
               Text="Вопрос будет здесь"
               FontSize="16"
               Margin="50,7,50,10"
               Foreground="#FFC3C3C3"
               TextWrapping="Wrap"
               Grid.Row="1"
               VerticalAlignment="Center"/>
            </ScrollViewer>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="2">
            <StackPanel x:Name="AnswersPanel" VerticalAlignment="Center" >
                <Border x:Name="brdAnswer1" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="2" Padding="5" Margin="50,7,50,7">
                    <Border.Background>
                        <SolidColorBrush Color="#80FFFFFF"/>
                    </Border.Background>
                    <RadioButton x:Name="Answer1" Content="Ответ 1" />
                </Border>
                <Border  x:Name="brdAnswer2" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="2" Padding="5" Margin="50,7,50,7">
                    <Border.Background>
                        <SolidColorBrush Color="#80FFFFFF"/>
                    </Border.Background>
                    <RadioButton x:Name="Answer2" Content="Ответ 2" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="pnProgressBar" VerticalAlignment="Center" Grid.Row="3">
            <TextBlock x:Name="Error" 
                  Margin="5,5,0,0" Height="30" 
                  Width="692"  
                 Foreground="Red" 
                 Text=""/>
            <Border BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="2" Padding="5" Margin="50,0,50,7" >
                <Border.Background>
                    <SolidColorBrush Color="#80FFFFFF"/>
                </Border.Background>
                <Grid HorizontalAlignment="Stretch">
                    <ProgressBar x:Name="TimerProgressBar" Height="20" Value="0" Maximum="100" Width="700"
             VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#446e9a"/>
                                <Setter Property="Background" Value="#7fa9c6"/>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock x:Name="TimerText" Text="01" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                 Foreground="#044080" FontSize="16"  FontWeight="Bold"/>
                </Grid>
            </Border>
        </StackPanel>


        <Grid x:Name="pnBtn" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10,10,10,20" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackQuestionButton" Content="Завершить" Click="FinishTestButton_Click"
                Grid.Column="0" Style="{StaticResource GradientButtonStyle}"/>
            
            <Button x:Name="MenuQuestionButton" Content="В меню" Click="MenuhTestButton_Click"
                Grid.Column="1" Style="{StaticResource GradientButtonStyle}"/>

            <Button x:Name="NextQuestionButton" Content="Далее" Click="NextQuestionButton_Click"
                Grid.Column="2" Style="{StaticResource GradientButtonStyle}"/>
        </Grid>


    </Grid>
</Window>
